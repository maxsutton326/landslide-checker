    "js-yaml": "^4.1.0",
    "papaparse": "^5.4.1",
    "proj4": "^2.11.0",
    "rbush": "^4.0.1",
    "shapefile": "^0.6.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
