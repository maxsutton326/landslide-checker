{
  "name": "landslide-data-quality-assessment",
  "version": "1.0.0",
  "description": "Landslide Data Quality Assessment System - Evaluate the quality of landslide mapping data by comparing multiple image sources",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.js",
    "test:watch": "node --test --watch tests/**/*.js",
